# Server port
PORT=4000

# Optional: only needed for server-side endpoints that bypass RLS
# (e.g. /api/stats). Dashboard → Project Settings → API → service_role key.
# Never expose this key to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...   # Stripe → Products → Pro → monthly price
STRIPE_PRICE_PRO_YEARLY=price_...    # Stripe → Products → Pro → yearly price
